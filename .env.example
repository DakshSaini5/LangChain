VITE_API_BASE=
# Frontend only. Origin of the deployed API, e.g. https://langchang-api.onrender.com
# Leave empty locally: Vite proxies /api to http://localhost:4000.

PORT=4000
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=20
TRANSLATION_SERVICE_URL=http://127.0.0.1:8001
# Where uploaded originals and translated files are kept.
DOCUMENT_STORAGE_DIR=data/jobs
# Temporary documents are deleted after this many minutes.
DOCUMENT_RETENTION_MINUTES=60
# Optional Tesseract location for OCR of scanned PDFs.
TESSERACT_CMD=
# Optional: used only by writing/email assistant features, not translation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Overall budget for one AI request before the assistant gives up and asks you to retry.
GEMINI_TIMEOUT_MS=150000
